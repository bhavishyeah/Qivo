{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "prisma.config.ts",
    "prisma/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/api",
    "apps/web"
  ]
}