# ─────────────────────────────────────────────────────────────
# API (apps/api) — set these in Railway on the API service
# ─────────────────────────────────────────────────────────────

# Postgres connection (Railway auto-sets DATABASE_URL when you add PostgreSQL).
# Use the pooled URL for the app and the direct URL for migrations.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Leave empty — Railway injects PORT at runtime. Defaults to 3000 locally.
PORT=

# Environment: "development" or "production"
NODE_ENV=development

# Public URL of the frontend (used for CORS + cookies). Must match exactly.
WEB_URL="http://localhost:5173"

# Session cookie config
SESSION_COOKIE_NAME="qivo_session"
SESSION_DAYS="30"

# Email (optional — sending is skipped if RESEND_API_KEY is unset)
EMAIL_FROM="Qivo Forms <onboarding@resend.dev>"
RESEND_API_KEY=

# Google Sign-In (optional — button is hidden if unset). Backend verifies tokens.
GOOGLE_CLIENT_ID=

# ─────────────────────────────────────────────────────────────
# Web (apps/web) — set these on the WEB service as BUILD-TIME vars.
# Vite inlines VITE_* at build time, so changing them requires a rebuild.
# (Local dev reads these from apps/web/.env.local instead.)
# ─────────────────────────────────────────────────────────────

# Base URL of the API the frontend calls.
VITE_API_URL="http://localhost:3000"

# Must match GOOGLE_CLIENT_ID above. Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
