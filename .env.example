# ─────────────────────────────────────────────────────────────
# API (apps/api) — set these in Railway on the API service
# ─────────────────────────────────────────────────────────────

# Postgres connection (Railway auto-sets DATABASE_URL when you add PostgreSQL).
# Use the pooled URL for the app and the direct URL for migrations.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Leave empty — Railway injects PORT at runtime. Defaults to 3000 locally.
PORT=

# Environment: "development" or "production"
NODE_ENV=development

# Public URL of the frontend (used for CORS + cookies). Must match exactly.
WEB_URL="http://localhost:5173"

# Session cookie config
SESSION_COOKIE_NAME="qivo_session"
SESSION_DAYS="30"

# Secret used to HMAC-sign same-session response-edit tokens. Optional:
# falls back to an insecure dev default if unset. SET A RANDOM VALUE IN PRODUCTION.
RESPONSE_EDIT_SECRET=

# Email (optional — sending is skipped if RESEND_API_KEY is unset).
# RESEND_API_KEY / EMAIL_FROM / WEB_URL are reused for form-share invites
# (behavior is identical to password-reset emails: silent no-op when unset).
EMAIL_FROM="Qivo Forms <onboarding@resend.dev>"
RESEND_API_KEY=

# Google Sign-In (optional — button is hidden if unset). Backend verifies tokens.
GOOGLE_CLIENT_ID=

# Cloudinary file uploads (optional — FILE_UPLOAD questions fail gracefully if
# unset). API-only. CLOUD_NAME and API_KEY are not secret; API_SECRET is and
# must never be exposed to the frontend. From Cloudinary Console > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limits, per 15-minute window. All optional; defaults shown.
# RATE_LIMIT_MAX: general API requests per logged-in session (or per IP when
#   not logged in). RATE_LIMIT_IP_MAX: per-IP backstop shared by all users on
#   one IP (campus networks). RATE_LIMIT_PUBLIC_MAX: public form views/submits
#   per IP. TRUST_PROXY_HOPS: proxies in front of the API (Railway = 1).
RATE_LIMIT_MAX=2000
RATE_LIMIT_IP_MAX=10000
RATE_LIMIT_PUBLIC_MAX=1000
TRUST_PROXY_HOPS=1
# Razorpay (optional — payments are off if the keys are unset). KEY_SECRET and
# WEBHOOK_SECRET are server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# !!! FAILS CLOSED !!! Razorpay payments only work for workspaces whose OWNER
# account email is listed here (comma-separated, case-insensitive). If this is
# unset or empty, payments are OFF FOR EVERYONE, including you. Set it on
# Railway BEFORE deploying, to the email you log into Qivo with.
PAYMENTS_ALLOWED_OWNER_EMAILS=

# Platform admins (comma-separated emails). Only these accounts can review form
# reports at /api/admin/reports and get notified when a form is auto-flagged.
# Unset or empty = nobody (fails closed).
PLATFORM_ADMIN_EMAILS=
# Optional secret mixed into the stored hash of reporter IPs (falls back to
# RESPONSE_EDIT_SECRET). Never store or log raw IPs.
REPORT_IP_SECRET=

# ─────────────────────────────────────────────────────────────
# Web (apps/web) — set these on the WEB service as BUILD-TIME vars.
# Vite inlines VITE_* at build time, so changing them requires a rebuild.
# (Local dev reads these from apps/web/.env.local instead.)
# ─────────────────────────────────────────────────────────────

# Base URL of the API the frontend calls.
VITE_API_URL="http://localhost:3000"

# Must match GOOGLE_CLIENT_ID above. Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
